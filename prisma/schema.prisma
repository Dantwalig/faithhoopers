generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COACH
  FACILITATOR
  PLAYER
  PARENT
}

enum SessionType {
  TRAINING
  GAME
  BIBLE_STUDY
  DEVOTIONAL
}

enum Gender {
  MALE
  FEMALE
}

model User {
  // Identity — most useful for browsing in Supabase dashboard
  id            String    @id @default(cuid())
  role          Role      @default(PLAYER)
  name          String
  email         String    @unique
  phone         String?
  emailVerified Boolean   @default(false)
  passwordSet   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Sensitive / internal fields
  password                  String
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  resetCode                 String?
  resetCodeExpiresAt        DateTime?

  // Relations
  player           Player?
  coach            Coach?
  facilitator      Facilitator?
  parent           Parent?
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@index([verificationCode])
  @@index([resetCode])
  @@map("users")
}

model Player {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  jerseyNumber  Int?
  position      String?
  gender        Gender?
  age           Int?
  medicalNotes  String?   // pre-existing health conditions / injuries, shared with coaches & admin only
  dateOfBirth   DateTime?
  parentId      String?
  parent        Parent?   @relation(fields: [parentId], references: [id])

  // Which coach/facilitator this player is assigned to (set by an admin).
  // Coaches/facilitators only see players assigned to them; a player can
  // be assigned to one of each, both, or neither.
  coachId       String?
  coach         Coach?       @relation("CoachPlayers", fields: [coachId], references: [id])
  facilitatorId String?
  facilitator   Facilitator? @relation("FacilitatorPlayers", fields: [facilitatorId], references: [id])

  attendances   Attendance[]
  createdAt     DateTime  @default(now())

  @@map("players")
}

model Coach {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String?   // e.g. "Defense", "Offense", "Conditioning"
  gender        Gender?
  createdAt     DateTime  @default(now())

  sessions      Session[] @relation("CoachSessions")
  players       Player[]  @relation("CoachPlayers")

  @@map("coaches")
}

model Facilitator {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String?
  gender        Gender?
  createdAt     DateTime  @default(now())

  players       Player[]  @relation("FacilitatorPlayers")

  @@map("facilitators")
}

model Parent {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  children      Player[]
  createdAt     DateTime  @default(now())

  @@map("parents")
}

model Session {
  id            String      @id @default(cuid())
  title         String
  type          SessionType
  description   String?
  location      String?
  startTime     DateTime
  endTime       DateTime
  coachId       String?
  coach         Coach?      @relation("CoachSessions", fields: [coachId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  attendances   Attendance[]

  @@map("sessions")
}

model Attendance {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  present     Boolean   @default(false)
  markedAt    DateTime  @default(now())
  notes       String?

  @@unique([playerId, sessionId])
  @@map("attendance")
}

model Devotional {
  id            String    @id @default(cuid())
  title         String
  weekTheme     String
  bibleReference String  // e.g. "John 3:16"
  bibleText     String   // fetched from API or manually entered
  commentary    String   // admin-written reflection
  application   String?  // practical takeaway
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("devotionals")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  urgent      Boolean   @default(false)
  targetRoles Role[]    // which roles can see this
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("announcements")
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String?   // null = broadcast
  receiver    User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject     String?
  body        String
  isBroadcast Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("messages")
}
