# Database — Supabase needs TWO different connection strings (see DEPLOY.md
# Step 4 for exactly where to copy these from in the Supabase dashboard):
#
# DATABASE_URL — the pooled "Transaction" connection string (port 6543).
#   Used by the app at runtime. Required for serverless platforms like Vercel,
#   where many functions can open connections at once.
# DIRECT_URL   — the "Direct connection" string (port 5432).
#   Used only by the Prisma CLI for `prisma db push`. The pooled connection
#   on its own makes db push hang or fail — Prisma needs a direct line for that.
#
# For local dev without Supabase: postgresql://USER:PASSWORD@localhost:5432/faith_hoopers
#   (in that case DATABASE_URL and DIRECT_URL can be identical)
DATABASE_URL="postgresql://postgres.xxxxxxxx:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret-string"
NEXTAUTH_URL="http://localhost:3000"

# Bible API (optional but recommended)
# Get a free key at: https://scripture.api.bible
# Without a key, devotionals fall back to manual text entry
BIBLE_API_KEY="your-api-bible-key-here"
BIBLE_API_BASE="https://api.scripture.api.bible/v1"
# Default Bible version — "de4e12af7f28f599-01" is the KJV
BIBLE_VERSION_ID="de4e12af7f28f599-01"

# Email (required for signup verification codes / welcome emails)
# Uses Gmail SMTP via Nodemailer — no domain or paid service needed.
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords and generate an App Password
# 3. Paste your Gmail address and the 16-character app password below.
# Without these set, emails are skipped (logged to the server console instead) —
# signups will still work locally, but nobody will receive their verification code.
GMAIL_USER="you@gmail.com"
GMAIL_PASS="your-16-char-app-password"
